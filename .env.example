# AI-провайдер: anthropic | mock | none
#   anthropic — Claude через API (нужен ключ)
#   mock      — локальная эвристика без сети, для разработки
#   none      — AI выключен
AI_PROVIDER=anthropic

# API-ключ Anthropic. Пусто = AI выключен, приложение работает без него.
ANTHROPIC_API_KEY=

# Модель (необязательно)
AI_MODEL=claude-opus-5-5

# Таймаут запроса к AI, мс
AI_TIMEOUT_MS=30000

# Строка подключения к базе Neon Postgres. Пусто = без аккаунтов, задачи только в браузере.
DATABASE_URL=

# Порт локального сервера
PORT=3000
